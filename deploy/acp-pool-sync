#!/usr/bin/python3
"""Root-only: discover labN.env workers, probe account login, reload on changes only."""
import concurrent.futures
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile
import time
import http.client
import socket

cfg = Path('/etc/acp-gateway')
pool = Path('/etc/nginx/acp-gateway')

def valid_slot(name):
    return re.fullmatch(r'lab(?:[1-9]|[1-5][0-9]|6[0-4])',name) is not None

def readenv(path):
    return dict(line.split('=', 1) for line in path.read_text().splitlines() if '=' in line and not line.startswith('#'))

def probe(item):
    name, key = item
    path = f'/run/acp-gateway-sockets/{name}.sock'
    conn = http.client.HTTPConnection('localhost', timeout=20)
    try:
        conn.sock = socket.socket(socket.AF_UNIX)
        conn.sock.settimeout(20)
        conn.sock.connect(path)
        conn.request('GET', '/v1/models', headers={'Authorization':'Bearer '+key})
        resp = conn.getresponse()
        body = resp.read(262144)
        if resp.status == 200:
            ok = bool(json.loads(body)['data'])
        else:
            ok = False if resp.status == 401 or (resp.status == 503 and b'Antigravity login required' in body) else None
    except (FileNotFoundError, ConnectionRefusedError):
        ok = False
    except (OSError, KeyError, TypeError, ValueError, http.client.HTTPException):
        ok = None
    finally:
        conn.close()
    return name, path, ok

def replace(path, content, mode=0o600):
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as f:
        os.fchmod(f.fileno(),mode)
        f.write(content.encode())
    os.replace(f.name, path)

def main():
    pool.mkdir(mode=0o700, exist_ok=True)
    with (pool/'sync.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        members, availability = pool/'members.inc', pool/'availability.inc'
        old = {p:p.read_text() if p.exists() else None for p in (members,availability)}
        key = readenv(cfg/'shared.env')['GATEWAY_API_KEY']
        items = [(p.stem,key) for p in sorted(cfg.glob('lab*.env')) if valid_slot(p.stem)]
        lines=[]
        with concurrent.futures.ThreadPoolExecutor(max_workers=4) as workers:
            for name,path,ok in workers.map(probe,items):
                line=f'    server unix:{path}; # {name}\n'
                if ok is True or (ok is None and line in (old[members] or '').splitlines(keepends=True)):
                    lines.append(line)
                print(name, 'ready' if ok else ('offline or authentication required' if ok is False else 'probe inconclusive'))
        new = {members: ''.join(lines) or '    server 127.0.0.1:1 down;\n', availability: '# active pool\n' if lines else 'default_type application/json;\nreturn 503 \'{"error":{"message":"No authenticated lab account available"}}\';\n'}
        manifest=Path('/run/acp-gateway-sockets/pool.json')
        manifest.parent.mkdir(mode=0o755,exist_ok=True)
        replace(manifest,json.dumps({'slots':[line.split('# ')[1].strip() for line in lines],'updated':int(time.time())}),0o644)
        if old==new: return
        try:
            for p,s in new.items(): replace(p,s)
            subprocess.run(['nginx','-t','-q'],check=True)
            # Legacy installations still route via includes until the router vhost is installed.
            vhost=Path('/etc/nginx/conf.d/zzzz-agy-api.conf')
            if not vhost.exists() or 'proxy_pass http://agy_lab_accounts;' in vhost.read_text():
                subprocess.run(['systemctl','reload','nginx'],check=True)
        except BaseException:
            for p,s in old.items():
                if s is None: p.unlink(missing_ok=True)
                else: replace(p,s)
            raise

if __name__=='__main__': main()
